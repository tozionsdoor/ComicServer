#!/bin/sh
set -e

# Python 依存パッケージのインストール
echo "[ArcHive] Python パッケージをインストール中..."
pip3 install --quiet --break-system-packages \
    "fastapi>=0.110" \
    "uvicorn[standard]>=0.29" \
    "pillow>=10.0" \
    "rarfile>=4.1" \
    "pymupdf>=1.23" \
    "cryptography>=41" \
    "python-multipart>=0.0.9" \
    || pip3 install --quiet \
    "fastapi>=0.110" \
    "uvicorn[standard]>=0.29" \
    "pillow>=10.0" \
    "rarfile>=4.1" \
    "pymupdf>=1.23" \
    "cryptography>=41" \
    "python-multipart>=0.0.9"

# アプリディレクトリの作成
mkdir -p /apps/archiveserver/cache

# systemd サービスの有効化・起動
if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload
    systemctl enable fvapp-archiveserver.service
    systemctl start  fvapp-archiveserver.service
    echo "[ArcHive] サービスを起動しました"
fi

echo "[ArcHive] インストール完了"
echo "[ArcHive] 管理ページ: http://$(hostname -I | awk '{print $1}'):8765/admin"
echo "[ArcHive] ※スキャンフォルダの設定は /apps/archiveserver/manga_server_config.json の scan_dirs で行ってください"
